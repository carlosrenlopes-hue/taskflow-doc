{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TaskFlow API",
  "description": "Public developer documentation for the TaskFlow task management API.",
  "colors": {
    "primary": "#2563EB",
    "light": "#3B82F6",
    "dark": "#1D4ED8"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "boost": 2,
        "pages": [
          "introduction",
          "authentication",
          "quickstart"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/projects",
          "guides/tasks",
          "guides/errors"
        ]
      },
      {
        "group": "API Reference",
        "openapi": "https://raw.githubusercontent.com/writechoiceorg/Technical-Writing-Test-TaskFlow-API/main/openapi.yaml",
        "pages": [
          "api-reference/overview",
          "POST /projects",
          "POST /tasks",
          "GET /projects/{project_id}/tasks",
          "PATCH /tasks/{task_id}",
          "DELETE /tasks/{task_id}"
        ]
      }
    ]
  },
  "api": {
    "baseUrl": "https://test-writechoice.onrender.com",
    "auth": {
      "method": "bearer"
    },
    "playground": {
      "mode": "show"
    }
  }
}
